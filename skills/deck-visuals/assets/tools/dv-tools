#!/bin/sh
# dv-tools — picks and execs the right prebuilt binary for this machine.
set -eu

here="$(cd "$(dirname "$0")" && pwd)"

case "$(uname -s)" in
  Darwin) os=darwin ;;
  Linux) os=linux ;;
  *) echo "dv-tools: unsupported OS $(uname -s)" >&2; exit 1 ;;
esac

case "$(uname -m)" in
  arm64|aarch64) arch=arm64 ;;
  x86_64|amd64) arch=amd64 ;;
  *) echo "dv-tools: unsupported architecture $(uname -m)" >&2; exit 1 ;;
esac

bin="$here/bin/dv-tools-$os-$arch"
if [ ! -x "$bin" ]; then
  echo "dv-tools: no binary for $os/$arch at $bin — run build.sh" >&2
  exit 1
fi

exec "$bin" "$@"
